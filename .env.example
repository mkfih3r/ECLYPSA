# ==============================================================================
# ECLYPSA AI - Environment Configuration Example
# Copy this file to '.env' and fill in your actual values.
# DO NOT COMMIT YOUR REAL '.env' FILE TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
ENV=development                                # Core environment: development | staging | production
DEBUG=true                                     # Enable detailed debug logs (true/false)
APP_PORT=8080                                  # Internal API port
SECRET_KEY=your-super-secret-32-character-key  # Used for session/JWT encryption

# ------------------------------------------------------------------------------
# Security & TLS
# ------------------------------------------------------------------------------
ALLOWED_HOSTS=localhost,127.0.0.1              # Comma-separated allowed host headers
CORS_ORIGINS=http://localhost:3000             # Comma-separated allowed CORS origins
SSL_ENABLED=false                              # Enable SSL/TLS termination (true/false)

# ------------------------------------------------------------------------------
# LLM & Model Provider API Keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
HUGGINGFACE_TOKEN=hf_your_huggingface_access_token_here

# ------------------------------------------------------------------------------
# Default Model Parameters
# ------------------------------------------------------------------------------
DEFAULT_MODEL_PROVIDER=openai                 # openai | anthropic | local
DEFAULT_MODEL_NAME=gpt-4o                      # Default model identifier
TEMPERATURE=0.7                                # Sampling temperature (0.0 to 1.0)
MAX_TOKENS=4096                                # Maximum response length in tokens

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL / Vector DB)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eclypsa_ai_db
DB_USER=eclypsa_user
DB_PASSWORD=your_secure_db_password_here

# Vector Database (Qdrant / Pinecone / Chroma)
VECTOR_DB_TYPE=qdrant                          # qdrant | pinecone | chroma
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_API_KEY=your_vector_db_api_key_here

# ------------------------------------------------------------------------------
# Cache & Session Storage (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# ------------------------------------------------------------------------------
# Telemetry & Monitoring
# ------------------------------------------------------------------------------
ENABLE_TELEMETRY=true                          # Enable performance and usage logging
LOG_LEVEL=info                                 # debug | info | warning | error | critical
PROMETHEUS_METRICS_PORT=9090